{
  "name": "@deepseek-ai/dsh-session-persistence-sqlite",
  "description": "SQLite durable session persistence backend for the DeepSeek Harness",
  "version": "0.1.2-alpha.3",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
